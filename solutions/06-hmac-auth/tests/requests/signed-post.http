# Case 2 — a correctly signed write.
#
# Signing base (note the trailing newline — it is part of the string):
#   {{KEY_ID}}\n
#   POST /albums\n
#   date: {{DATE}}\n
#   digest: {{DIGEST}}\n
#
# signature = base64(HMAC-SHA256({{SECRET_KEY}}, <that base>))
# DIGEST    = SHA-256=base64(sha256(<the exact bytes of the body below>))
#
# Generate both with ../../example/verify.sh, or the worked example in ../../README.md.

POST {{GATEWAY}}/albums
Content-Type: application/json
Date: {{DATE}}
Digest: {{DIGEST}}
Authorization: Signature keyId="{{KEY_ID}}",algorithm="hmac-sha256",headers="@request-target date digest",signature="{{SIGNATURE}}"

{"title":"order-created","userId":1}
