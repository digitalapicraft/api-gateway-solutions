# Case 5 — the correct key_id, signed with the wrong secret.
# Everything about this request is well-formed. Only the shared secret is wrong.
# If this is ever accepted, the signature is decorative.

POST {{GATEWAY}}/posts
Content-Type: application/json
Date: {{DATE}}
Digest: {{DIGEST}}
Authorization: Signature keyId="{{KEY_ID}}",algorithm="hmac-sha256",headers="@request-target date digest",signature="{{SIGNATURE_WITH_WRONG_SECRET}}"

{"title":"order-created","body":"sku-1","userId":1}
