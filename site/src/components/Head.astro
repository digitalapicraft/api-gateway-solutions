---
// Renders ```mermaid fences in the browser.
//
// The build-time alternative (rehype-mermaid) needs Playwright in CI for a
// headless browser. Doing it client-side keeps the CI job to node alone, and
// GitHub already renders the identical fence natively — so the source markdown
// stays a plain ```mermaid block either way.
import Default from '@astrojs/starlight/components/Head.astro'
---
<Default><slot /></Default>
<script>
  const blocks = document.querySelectorAll('code.language-mermaid, pre.language-mermaid code')
  if (blocks.length) {
    const { default: mermaid } = await import(
      'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
    const dark = document.documentElement.dataset.theme === 'dark'
    mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'default' })
    let i = 0
    for (const b of blocks) {
      const host = b.closest('pre') ?? b
      const src = b.textContent ?? ''
      try {
        const { svg } = await mermaid.render(`m${i++}`, src)
        const fig = document.createElement('figure')
        fig.className = 'mermaid-figure'
        fig.innerHTML = svg
        host.replaceWith(fig)
      } catch {
        /* leave the code block as-is; a visible fence beats an error box */
      }
    }
  }
</script>
